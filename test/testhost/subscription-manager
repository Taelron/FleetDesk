#!/bin/bash
# Inert subscription-manager stub (TAE-98 AC 9). It registers nothing: real
# registration is explicitly out of scope for this fixture (see README.md).
# It exists only so a command that hands it a credential on stdin has a
# process to observe in the container's process listing while it runs.
#
# Consumes stdin until EOF (or a 20s cap, in case a caller never closes it),
# then exits 0.
set -euo pipefail
timeout 20 cat >/dev/null || true
exit 0
